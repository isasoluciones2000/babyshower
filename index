    <script>
        // ==========================================================
        // CUENTA REGRESIVA
        // Evento: Domingo 23 de agosto de 2026 - 6:00 PM
        // Hora local de Perú: UTC-5
        // ==========================================================
        const eventDate = new Date("2026-08-23T18:00:00-05:00").getTime();
        let celebrationLaunched = false;

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = eventDate - now;

            const daysEl = document.getElementById("days");
            const hoursEl = document.getElementById("hours");
            const minutesEl = document.getElementById("minutes");
            const secondsEl = document.getElementById("seconds");

            if (distance <= 0) {
                daysEl.textContent = "00";
                hoursEl.textContent = "00";
                minutesEl.textContent = "00";
                secondsEl.textContent = "00";

                if (!celebrationLaunched) {
                    celebrationLaunched = true;

                    if (typeof confetti === "function") {
                        confetti({
                            particleCount: 150,
                            spread: 100,
                            origin: { y: 0.6 }
                        });
                    }
                }

                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor(
                (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
            );
            const minutes = Math.floor(
                (distance % (1000 * 60 * 60)) / (1000 * 60)
            );
            const seconds = Math.floor(
                (distance % (1000 * 60)) / 1000
            );

            daysEl.textContent = String(days).padStart(2, "0");
            hoursEl.textContent = String(hours).padStart(2, "0");
            minutesEl.textContent = String(minutes).padStart(2, "0");
            secondsEl.textContent = String(seconds).padStart(2, "0");
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);


        // ==========================================================
        // COPIAR NÚMERO DE YAPE
        // ==========================================================
        const copyButton = document.getElementById("copyYape");
        const copyMessage = document.getElementById("copyMessage");
        const yapeNumber = "903051441";

        copyButton.addEventListener("click", async function () {
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(yapeNumber);
                } else {
                    // Método alternativo para navegadores antiguos
                    const textArea = document.createElement("textarea");
                    textArea.value = yapeNumber;
                    textArea.style.position = "fixed";
                    textArea.style.left = "-999999px";
                    textArea.style.top = "-999999px";

                    document.body.appendChild(textArea);
                    textArea.focus();
                    textArea.select();

                    document.execCommand("copy");
                    textArea.remove();
                }

                copyMessage.innerHTML =
                    '<i class="fa-solid fa-circle-check"></i> ¡Número copiado correctamente!';

                copyButton.innerHTML =
                    '<i class="fa-solid fa-check"></i> ¡Número copiado!';

                // Pequeña celebración
                if (typeof confetti === "function") {
                    const rect = copyButton.getBoundingClientRect();

                    confetti({
                        particleCount: 50,
                        spread: 55,
                        origin: {
                            x: (rect.left + rect.width / 2) / window.innerWidth,
                            y: (rect.top + rect.height / 2) / window.innerHeight
                        }
                    });
                }

                setTimeout(() => {
                    copyButton.innerHTML =
                        '<i class="fa-regular fa-copy"></i> Copiar número de Yape';
                    copyMessage.textContent = "";
                }, 3000);

            } catch (error) {
                copyMessage.textContent =
                    "No se pudo copiar automáticamente. Número: " + yapeNumber;
            }
        });


        // ==========================================================
        // CONFETI DE BIENVENIDA SUAVE
        // ==========================================================
        window.addEventListener("load", function () {
            setTimeout(() => {
                if (typeof confetti === "function") {
                    confetti({
                        particleCount: 35,
                        angle: 60,
                        spread: 50,
                        origin: { x: 0 }
                    });

                    confetti({
                        particleCount: 35,
                        angle: 120,
                        spread: 50,
                        origin: { x: 1 }
                    });
                }
            }, 900);
        });
    </script>

